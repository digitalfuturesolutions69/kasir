DATABASE_URL="postgresql://duitku:password@localhost:5432/duitku"
JWT_SECRET="replace-with-a-long-random-secret"

# Needed for the "unggah foto bukti transaksi" feature (reads amount/type
# from a receipt photo via AI vision). Which provider is actually used is
# a single app-wide switch an admin sets from /admin (default: Claude) —
# only the key for whichever one is currently selected needs to be set.
# Without the matching key, photo upload still saves the image but skips
# auto-fill — users just enter the amount/type manually.
ANTHROPIC_API_KEY=""   # https://console.anthropic.com/
OPENAI_API_KEY=""      # https://platform.openai.com/api-keys

# Email(s) allowed into /admin (the owner dashboard) — comma separated for
# multiple owners. The account must be registered with this exact email.
# Leave empty to disable the admin dashboard entirely.
ADMIN_EMAIL=""
