generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Plan {
  FREE
  PRO
  UMKM
}

enum AiProvider {
  CLAUDE
  OPENAI
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  plan            Plan     @default(FREE)
  // AI receipt-scan usage for the current monthly period, reset lazily
  // (see receipts.ts) whenever scanPeriodStart falls in an earlier
  // calendar month than "now" — no cron job needed.
  scanCount       Int      @default(0)
  scanPeriodStart DateTime @default(now())
  // Which AI reads the receipt photo for this user — set in /pengaturan,
  // or overridden by an admin. See receipts.ts for the dispatch logic.
  aiProvider      AiProvider @default(CLAUDE)

  categories   Category[]
  transactions Transaction[]
}

model Category {
  id        String           @id @default(cuid())
  name      String
  type      TransactionType
  color     String           @default("#6366f1")
  icon      String           @default("wallet")
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([userId, name, type])
}

model Transaction {
  id          String           @id @default(cuid())
  type        TransactionType
  amount      Float
  description String?
  date        DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  receiptPath String?

  @@index([userId, date])
}
